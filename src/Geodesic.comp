#version 430 core

// This defines the size of a "work group". Think of it as a batch of shader
// invocations that run together. 16x16 = 256 threads per group is a common size.
layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// This is the output texture that our shader will write the final pixel colors to.
// We bind it to "image unit 0". The 'rgba8' format means 8 bits for Red, Green, Blue, and Alpha.
layout (rgba8, binding = 0) uniform writeonly image2D destTex;

// --- Data Structures (Mirrors of your C++ structs) ---

struct Ray {
	dvec3 cartesianPosition;

	double r, phi, theta;    // Position in spherical coordinates
	double dr, dphi, dtheta; // Velocity based on affine parameter (dlambda)

	double E; // Energy
	double L; // Angular Momentum
};

struct BlackHole {
	dvec3 position;
	double R_S; // Schwarzschild Radius (Event Horizon)
};

struct SceneObject {
	dvec3 position;
	double radius;
	vec3 color;
    // GLSL requires padding for struct members to align correctly in memory.
    // Adding a float here ensures proper alignment for the SSBO.
	float padding;
};

// --- Uniforms (Global variables sent from C++) ---

// Data that is the same for ALL shader invocations.
uniform dvec3 u_cameraPos;
uniform mat4 u_cameraInverseView; // To transform ray directions
uniform int u_screenWidth;
uniform int u_screenHeight;

// We use a Shader Storage Buffer Object (SSBO) for the array of objects.
// This is more flexible than a uniform for variable-sized arrays.
layout(std430, binding = 1) buffer ObjectBuffer {
    SceneObject objects[];
};

// --- Constants (Mirrored from C++) ---
const double dLambda = 1e7;
const int maxSteps = 2000; // Reduced for GPU to prevent timeouts. Adjust as needed.

// --- Global Instance of the Black Hole ---
// It's a single object, so we can define it as a uniform.
uniform BlackHole u_blackHole;


// --- GLSL Function Declarations ---
// We need to declare functions before they are used, just like in C++.
void GetDerivatives(const Ray ray, double R_S, out double d2r, out double d2theta, out double d2phi);
void RK4STEP(inout Ray ray, double R_S);
vec3 TraceAndGetColor(inout Ray initialRay);
Ray GetInitialRay(uvec2 pixelCoord);
void UpdateCartesian(inout Ray ray);


// --- Function Implementations (Translated from C++) ---

void UpdateCartesian(inout Ray ray) {
    ray.cartesianPosition.x = ray.r * sin(ray.theta) * cos(ray.phi);
    ray.cartesianPosition.y = ray.r * sin(ray.theta) * sin(ray.phi);
    ray.cartesianPosition.z = ray.r * cos(ray.theta);
}

void CartesianToPolar(dvec3 cartesian, out double r, out double theta, out double phi) {
    r = length(cartesian);
    if (r < 1e-10) {
        theta = 0.0;
        phi = 0.0;
        return;
    }
    theta = acos(cartesian.z / r);
    phi = atan(cartesian.y, cartesian.x);
}

bool InterceptBlackHole(double r) {
    return r <= u_blackHole.R_S;
}

// Note: Using 'inout' to modify the 'color' parameter if an object is hit.
bool InterceptObjects(dvec3 pos, out vec3 color) {
    for (int i = 0; i < objects.length(); ++i) {
        dvec3 op = pos - objects[i].position;
        if (dot(op, op) < (objects[i].radius * objects[i].radius)) {
            color = objects[i].color / 255.0; // Normalize color to 0-1 range
            return true;
        }
    }
    return false;
}


Ray GetInitialRay(uvec2 pixelCoord) {
    Ray initialRay;

    // Convert pixel coordinates to normalized device coordinates (-1 to 1)
    double normalizedX = (2.0 * pixelCoord.x / double(u_screenWidth)) - 1.0;
    double normalizedY = 1.0 - (2.0 * pixelCoord.y / double(u_screenHeight));

    // Simple perspective projection ray generation
    vec4 ray_clip = vec4(normalizedX, normalizedY, -1.0, 1.0);
    vec4 ray_eye = inverse(mat4(0.0)) * ray_clip; // Placeholder for projection matrix if needed
    vec4 ray_wor4 = u_cameraInverseView * ray_eye;
    
    dvec3 rayDir = normalize(dvec3(ray_wor4.xyz));

    initialRay.cartesianPosition = u_cameraPos;
    CartesianToPolar(initialRay.cartesianPosition, initialRay.r, initialRay.theta, initialRay.phi);

    // Convert cartesian velocity to spherical velocity
    double dx = rayDir.x, dy = rayDir.y, dz = rayDir.z;

    initialRay.dr = sin(initialRay.theta) * cos(initialRay.phi) * dx + sin(initialRay.theta) * sin(initialRay.phi) * dy + cos(initialRay.theta) * dz;
    initialRay.dtheta = (cos(initialRay.theta) * cos(initialRay.phi) * dx + cos(initialRay.theta) * sin(initialRay.phi) * dy - sin(initialRay.theta) * dz) / initialRay.r;
    initialRay.dphi = (-sin(initialRay.phi) * dx + cos(initialRay.phi) * dy) / (initialRay.r * sin(initialRay.theta));
    
    double scaleFactor = u_blackHole.R_S;
    initialRay.dr *= scaleFactor;
    initialRay.dtheta *= scaleFactor;
    initialRay.dphi *= scaleFactor;

    double f = 1.0 - u_blackHole.R_S / initialRay.r;
    double dt_dL = sqrt((initialRay.dr * initialRay.dr) / f + initialRay.r * initialRay.r * (initialRay.dtheta * initialRay.dtheta + sin(initialRay.theta) * sin(initialRay.theta) * initialRay.dphi * initialRay.dphi));

    initialRay.E = f * dt_dL;
    
    return initialRay;
}

vec3 TraceAndGetColor(inout Ray initialRay) {
    Ray currentRay = initialRay;
    vec3 objectColor;

    for (int i = 0; i < maxSteps; i++) {
        if (currentRay.r > 1e12) {
            return vec3(0.0, 0.0, 0.0); // Escaped to space
        }

        if (InterceptBlackHole(currentRay.r)) {
            return vec3(0.0, 0.0, 0.0); // Hit black hole (black)
        }

        if (InterceptObjects(currentRay.cartesianPosition, objectColor)) {
            return objectColor; // Hit an object
        }

        RK4STEP(currentRay, u_blackHole.R_S);
        UpdateCartesian(currentRay);
    }

    return vec3(0.0, 0.0, 0.0); // Return black if nothing is hit
}

void GetDerivatives(const Ray ray, double R_S, out double d2r, out double d2theta, out double d2phi) {
    double r = ray.r, theta = ray.theta;
    double dr = ray.dr, dtheta = ray.dtheta, dphi = ray.dphi;

    double f = 1.0 - R_S / r;
    if (abs(f) < 1e-10) { // Check for floating point inaccuracy near zero
        d2r = d2theta = d2phi = 0.0;
        return;
    }

    double dt_dL = ray.E / f;

    d2r = -(R_S / (2.0 * r * r)) * f * dt_dL * dt_dL
        + (R_S / (2.0 * r * r * f)) * dr * dr
        + r * f * (dtheta * dtheta + sin(theta) * sin(theta) * dphi * dphi);

    d2theta = -2.0 * dr * dtheta / r
        + sin(theta) * cos(theta) * dphi * dphi;

    double sin_theta = sin(theta);
    if (abs(sin_theta) < 1e-10) {
        d2phi = 0.0;
    } else {
        d2phi = -2.0 * dr * dphi / r
              - 2.0 * cos(theta) / sin_theta * dtheta * dphi;
    }
}

void RK4STEP(inout Ray ray, double R_S) {
    // --- K1 ---
    Ray k1_ray = ray;
    double k1_d2r, k1_d2theta, k1_d2phi;
    GetDerivatives(k1_ray, R_S, k1_d2r, k1_d2theta, k1_d2phi);

    // --- K2 ---
    Ray k2_ray = ray;
    k2_ray.r      += 0.5 * dLambda * k1_ray.dr;
    k2_ray.theta  += 0.5 * dLambda * k1_ray.dtheta;
    k2_ray.phi    += 0.5 * dLambda * k1_ray.dphi;
    k2_ray.dr     += 0.5 * dLambda * k1_d2r;
    k2_ray.dtheta += 0.5 * dLambda * k1_d2theta;
    k2_ray.dphi   += 0.5 * dLambda * k1_d2phi;
    double k2_d2r, k2_d2theta, k2_d2phi;
    GetDerivatives(k2_ray, R_S, k2_d2r, k2_d2theta, k2_d2phi);

    // --- K3 ---
    Ray k3_ray = ray;
    k3_ray.r      += 0.5 * dLambda * k2_ray.dr;
    k3_ray.theta  += 0.5 * dLambda * k2_ray.dtheta;
    k3_ray.phi    += 0.5 * dLambda * k2_ray.dphi;
    k3_ray.dr     += 0.5 * dLambda * k2_d2r;
    k3_ray.dtheta += 0.5 * dLambda * k2_d2theta;
    k3_ray.dphi   += 0.5 * dLambda * k2_d2phi;
    double k3_d2r, k3_d2theta, k3_d2phi;
    GetDerivatives(k3_ray, R_S, k3_d2r, k3_d2theta, k3_d2phi);

    // --- K4 ---
    Ray k4_ray = ray;
    k4_ray.r      += dLambda * k3_ray.dr;
    k4_ray.theta  += dLambda * k3_ray.dtheta;
    k4_ray.phi    += dLambda * k3_ray.dphi;
    k4_ray.dr     += dLambda * k3_d2r;
    k4_ray.dtheta += dLambda * k3_d2theta;
    k4_ray.dphi   += dLambda * k3_d2phi;
    double k4_d2r, k4_d2theta, k4_d2phi;
    GetDerivatives(k4_ray, R_S, k4_d2r, k4_d2theta, k4_d2phi);

    // --- Final update
    ray.r      += (dLambda / 6.0) * (k1_ray.dr + 2.0 * k2_ray.dr + 2.0 * k3_ray.dr + k4_ray.dr);
    ray.theta  += (dLambda / 6.0) * (k1_ray.dtheta + 2.0 * k2_ray.dtheta + 2.0 * k3_ray.dtheta + k4_ray.dtheta);
    ray.phi    += (dLambda / 6.0) * (k1_ray.dphi + 2.0 * k2_ray.dphi + 2.0 * k3_ray.dphi + k4_ray.dphi);
    ray.dr     += (dLambda / 6.0) * (k1_d2r + 2.0 * k2_d2r + 2.0 * k3_d2r + k4_d2r);
    ray.dtheta += (dLambda / 6.0) * (k1_d2theta + 2.0 * k2_d2theta + 2.0 * k3_d2theta + k4_d2theta);
    ray.dphi   += (dLambda / 6.0) * (k1_d2phi + 2.0 * k2_d2phi + 2.0 * k3_d2phi + k4_d2phi);
}

// The main entry point for each shader invocation
void main() {
    // gl_GlobalInvocationID is a built-in variable that gives us the unique ID
    // of the current thread. We use its x and y components as our pixel coordinates.
    uvec2 pixelCoord = gl_GlobalInvocationID.xy;

    // Get the initial ray for this specific pixel.
    Ray ray = GetInitialRay(pixelCoord);
    
    // Trace the ray and find its color.
    vec3 color = TraceAndGetColor(ray);

    // Write the final color to the output texture at the correct coordinate.
    imageStore(destTex, ivec2(pixelCoord), vec4(color, 1.0));
}
